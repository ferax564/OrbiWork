<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>com.orbiwork.orbiwork</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <name>OrbiWork</name>
  <summary>Desktop GUI for coding agents</summary>
  <developer id="com.orbiwork">
    <name>OrbiWork contributors</name>
  </developer>
  <description>
    <p>
      OrbiWork is an open-source desktop app for coding agents. Work with your
      existing agent subscriptions, review code changes, and run commands in
      your projects.
    </p>
    <p>
      Connect from desktop, web, or mobile to continue working remotely.
    </p>
  </description>
  <launchable type="desktop-id">orbiwork.desktop</launchable>
  <icon type="stock">orbiwork</icon>
  <provides>
    <binary>orbiwork</binary>
  </provides>
  <categories>
    <category>Development</category>
  </categories>
  <url type="homepage">https://orbiwork.com</url>
  <url type="bugtracker">https://github.com/ferax564/orbiwork/issues</url>
  <url type="vcs-browser">https://github.com/ferax564/orbiwork</url>
</component>
