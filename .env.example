# OrbiWork builds with no cloud account, hosted relay, or telemetry by default.
# Nothing in this file is required. Every value below is opt-in and must point at
# infrastructure you run yourself. Do not add server-side secrets to this file.

# Optional: hosted sign-in and relay ("Connect"). Leave unset to build without it.
# Use your own Clerk instance (Clerk Dashboard: API keys, JWT templates, OAuth applications)
# and your own relay deployment (`infra/relay`).
# ORBIWORK_CLERK_PUBLISHABLE_KEY=
# ORBIWORK_CLERK_JWT_TEMPLATE=
# ORBIWORK_CLERK_CLI_OAUTH_CLIENT_ID=
# ORBIWORK_RELAY_URL=
# ORBIWORK_HOSTED_APP_URL=

# Optional: signed macOS passkey builds. The RP domain defaults to the Frontend API
# hostname encoded in ORBIWORK_CLERK_PUBLISHABLE_KEY.
# ORBIWORK_APPLE_TEAM_ID=ABC1234567
# ORBIWORK_MACOS_PROVISIONING_PROFILE=/absolute/path/to/app.provisionprofile
# ORBIWORK_CLERK_PASSKEY_RP_DOMAINS=example.clerk.accounts.dev,clerk.example.com

# Optional: product analytics. Off unless all three are set.
# ORBIWORK_TELEMETRY_ENABLED=true
# ORBIWORK_POSTHOG_KEY=
# ORBIWORK_POSTHOG_HOST=

# Optional: mobile over-the-air updates from your own Expo update feed. Off unless both are set.
# ORBIWORK_MOBILE_UPDATES_ENABLED=1
# ORBIWORK_MOBILE_UPDATES_URL=

# Optional: mobile OpenTelemetry export to your own collector. Off unless all three are set.
# ORBIWORK_MOBILE_OTLP_TRACES_URL=
# ORBIWORK_MOBILE_OTLP_TRACES_DATASET=
# ORBIWORK_MOBILE_OTLP_TRACES_TOKEN=
