{
  // Static landing page for orbiwork.com. No Worker code: Cloudflare serves the files in public/.
  "name": "orbiwork-site",
  "compatibility_date": "2026-11-01",
  "assets": { "directory": "./public" },
  "routes": [
    { "pattern": "orbiwork.com", "custom_domain": true },
    { "pattern": "www.orbiwork.com", "custom_domain": true },
  ],
  // Do not publish a *.workers.dev copy or keep request logs.
  "workers_dev": false,
  "observability": { "enabled": false },
}
